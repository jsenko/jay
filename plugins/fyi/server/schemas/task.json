{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fyi/task",
  "title": "Something that needs doing",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "next_action_at": {
      "type": "string",
      "format": "date",
      "description": "When to look at this again. Required: a task with no next action date is a note, not a task."
    },
    "due": {
      "type": "string",
      "format": "date",
      "description": "A real external deadline. Leave unset when there is none \u2014 do not invent one."
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in-progress",
        "blocked",
        "done",
        "cancelled"
      ],
      "default": "open"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "blocked_on": {
      "type": "string",
      "description": "What is preventing progress. Set whenever status is blocked."
    },
    "project": {
      "type": "string",
      "x-fyi-ref": "project",
      "description": "The project this task belongs to, by id."
    }
  },
  "required": [
    "next_action_at"
  ],
  "x-fyi-archive": {
    "field": "status",
    "terminal": [
      "done",
      "cancelled"
    ],
    "after_days": 14
  }
}
